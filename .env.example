VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public Cloudflare Turnstile site key. Leave unset until Supabase CAPTCHA is
# configured with the matching secret key.
VITE_TURNSTILE_SITE_KEY=

# Keeps the current waitlist site unchanged unless explicitly enabled at build
# time. Server-side Stripe and database kill switches must also be enabled.
VITE_BETA_CHECKOUT_VISIBLE=false
